# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── API keys ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=

# ── LLM selection ────────────────────────────────────────────────────────────
# groq | gemini | openai | openrouter
LLM_PROVIDER=groq
GROQ_MODELS=llama-3.3-70b-versatile
# Seconds between Groq calls — keeps free-tier runs under 30 req/min
GROQ_MIN_INTERVAL=2.1

# ── Search / scrape budget ───────────────────────────────────────────────────
SCRAPE_CAP_PER_ITEM=5
FREE_FETCH_MAX=8
ITEM_TIMEOUT_SEC=180
SCRAPE_HARD_DEADLINE_SEC=900
GOOGLE_SHOPPING_DISABLE_AFTER=

# ── Caching ──────────────────────────────────────────────────────────────────
SCRAPE_CACHE_HOURS=72
AGG_SCRAPE_CACHE_HOURS=72

# ── Data locations (optional — defaults to ./output) ─────────────────────────
# OUTPUT_DIR=/data
# DENTAL_DB_PATH=/data/dental_intel.sqlite3

# ── CORS origin for the deployed frontend ────────────────────────────────────
# ALLOWED_ORIGIN=https://your-frontend.vercel.app

# ── Debugging ────────────────────────────────────────────────────────────────
AGG_DEBUG=0
