GROQ_API_KEY=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
# PRICE-EVERYTHING pass: lift the per-item caps so ALL discovered URLs get a
# price (free-fetch $0 reads structured price for most; scrapes are cached).
FREE_FETCH_MAX=60
SCRAPE_CAP_PER_ITEM=40
# GROQ_API_KEY=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
# GROQ_API_KEY=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


# SERPAPI exhausted (250/250 free) — disabled so discovery uses Firecrawl+seeds+storefront
# SERPAPI_API_KEY=fac5c74c1875dd9b29fa94d9e7301b796645c862919f44b43119d4877af7bff6

# ── LLM provider ────────────────────────────────────────────────────────────
# Default is Groq (above). To switch to Gemini's free tier (no ~6K-TPM wall):
#   1) pip install openai      (already added to requirements.txt)
#   2) paste your key below     (free: https://aistudio.google.com/apikey)
#   3) uncomment LLM_PROVIDER=gemini
LLM_MODELS=gemini-2.5-flash
# Models rotate across gemini-2.0-flash + gemini-2.0-flash-lite by default.
# Gemini ACTIVE — new-account key. Only the 2.5 models have free quota here
# (2.0-flash returns 429); gemini-2.5-flash-lite tested 10/10 clean on a paced
# run, with gemini-2.5-flash as the rotation partner (separate quota bucket).
# reasoning_effort=none (in ai.py) avoids the 2.5 thinking-truncates-JSON bug.
# To fall back to Groq: set LLM_PROVIDER=groq and comment LLM_MODELS.
GEMINI_API_KEY=AIzaSyD8lWJEQIAXI_gOlXC5IaakqiOw-7SQyAY
# Gemini free DAILY request quota exhausts mid-order on this account (needs
# billing). Falling back to Groq to actually finish. To retry Gemini: uncomment
# the two lines below, set GROQ_MIN_INTERVAL=4, and ensure quota/billing.
# LLM_PROVIDER=gemini
# LLM_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
LLM_PROVIDER=gemini
GROQ_MIN_INTERVAL=0.4
# Optional: if you hit 429s on the free tier, slow the request pacer a touch:
# GROQ_MIN_INTERVAL=4

# ── Server ─────────────────────────────────────────────────────────────────────
# ALLOWED_ORIGIN=http://localhost:3000

# ACCURACY MODE: most-accurate 70b FIRST (was 8b-first for speed)
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant

GOOGLE_SHOPPING_DISABLE_AFTER=0
SCRAPE_HARD_DEADLINE_SEC=90

AGG_DEBUG=1
AGG_SCRAPE_CACHE_HOURS=1

SCRAPE_CACHE_HOURS=72

GROQ_TPM_PACER=0
# Round-robin across all 3 models' SEPARATE free-tier TPM buckets instead of
# waiting on one drained model (~3-5x faster on the free tier; no accuracy cost
# — same JSON, deterministic guards are model-independent).
GROQ_TPM_ROTATE=1


ITEM_TIMEOUT_SEC=300

EXTRACT_CHUNK=2

DISCOVERY_PURGE=3250498,2223852,1126830,1126831,3333466,3333468

# ACCURACY MODE: re-check low-confidence extractions on 70b
GROQ_ESCALATE=1

EXTRACT_LOGIC_VERSION=7
